---
import Base from '../layouts/Base.astro';
import Reveal from '../components/Reveal.astro';
---

<Base
  title="L’Artiste"
  description="Découvrez la page artiste de Carlay Art. Biographie, démarche et repères seront publiés après validation par l’artiste."
  currentPath="/a-propos"
>
  <section class="artist-hero" aria-labelledby="artist-title">
    <img
      src="/site/Carlay-art.jpg"
      alt="Visuel provisoire de l’artiste — contexte à confirmer"
      width="960"
      height="1280"
      loading="eager"
      fetchpriority="high"
    />
    <div class="artist-hero__veil" aria-hidden="true"></div>
    <div class="artist-hero__copy">
      <p class="eyebrow">L’Artiste</p>
      <h1 id="artist-title" class="display">Carlay</h1>
      <p class="accent-line">Portrait et contexte à valider avec l’artiste</p>
    </div>
  </section>

  <section class="artist-story" aria-labelledby="story-title">
    <Reveal class="artist-story__intro">
      <p class="draft-label">Contenu éditorial en attente</p>
      <h2 id="story-title" class="display">Une page prête à accueillir le récit de l’artiste.</h2>
      <p>
        La structure, le rythme et les emplacements sont finalisés. Le texte sera remplacé par une
        biographie, une démarche et des repères approuvés, sans déduire de faits à partir des œuvres.
      </p>
      <blockquote>« Citation de l’artiste — texte exact à fournir. »</blockquote>
    </Reveal>

    <div class="story-grid">
      <Reveal as="article" class="story-card">
        <p class="story-card__number">01</p>
        <h3>Biographie</h3>
        <p>
          À fournir : parcours, lieux importants et chronologie que l’artiste souhaite rendre publics.
        </p>
        <span>Statut · validation artiste requise</span>
      </Reveal>
      <Reveal as="article" class="story-card">
        <p class="story-card__number">02</p>
        <h3>Démarche &amp; processus</h3>
        <p>
          À fournir : médiums, gestes, outils, inspirations et méthode de travail dans les mots de
          l’artiste.
        </p>
        <span>Statut · validation artiste requise</span>
      </Reveal>
      <Reveal as="article" class="story-card">
        <p class="story-card__number">03</p>
        <h3>Repères vérifiés</h3>
        <p>
          À fournir : séries à mettre en avant, marchés ou lieux citables et toute sélection de dates
          utiles.
        </p>
        <span>Statut · validation artiste requise</span>
      </Reveal>
    </div>
  </section>

  <section class="artist-facts" aria-labelledby="facts-title">
    <h2 id="facts-title" class="sr-only">Repères de l’artiste à confirmer</h2>
    <div>
      <span>Médium</span>
      <strong>À confirmer</strong>
    </div>
    <div>
      <span>Séries à présenter</span>
      <strong>À confirmer</strong>
    </div>
    <div>
      <span>Repères géographiques</span>
      <strong>À confirmer</strong>
    </div>
  </section>

  <section class="signature-block" aria-labelledby="signature-title">
    <Reveal class="signature-block__inner">
      <div>
        <p class="eyebrow">Signature</p>
        <h2 id="signature-title" class="display">Le dernier mot appartient à l’artiste.</h2>
        <p>
          Le fichier de signature actuellement disponible est présenté comme repère visuel. Son usage
          et sa version définitive restent à approuver.
        </p>
      </div>
      <figure>
        <img
          src="/site/Carlay-art-signature.png"
          alt="Signature Carlay, version à valider"
          width="300"
          height="145"
          loading="lazy"
        />
        <figcaption>Fichier provisoire · validation requise</figcaption>
      </figure>
    </Reveal>
  </section>

  <section class="contact-handoff" aria-labelledby="contact-title">
    <Reveal class="contact-handoff__inner">
      <p class="eyebrow">Contact</p>
      <h2 id="contact-title" class="display">Presse, galeries &amp; demandes sur une œuvre</h2>
      <p>Un canal direct est déjà disponible pendant que les contenus définitifs sont réunis.</p>
      <div class="contact-handoff__actions">
        <a class="button" href="mailto:carlayart369@gmail.com">Écrire à Carlay Art</a>
        <a class="text-link" href="/contact">Voir les options de contact <span aria-hidden="true">→</span></a>
      </div>
    </Reveal>
  </section>
</Base>

<style>
  .artist-hero {
    position: relative;
    min-height: min(82vh, 52rem);
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    background: var(--surface);
  }

  .artist-hero > img,
  .artist-hero__veil {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .artist-hero > img {
    object-fit: cover;
    object-position: center 30%;
    filter: grayscale(1) contrast(1.04);
  }

  .artist-hero__veil {
    background: linear-gradient(180deg, rgb(10 10 10 / 35%) 0%, rgb(10 10 10 / 8%) 42%, var(--noir) 100%);
  }

  .artist-hero__copy {
    position: relative;
    z-index: 1;
    width: min(100%, var(--content-width));
    margin-inline: auto;
    padding: 5rem var(--pad) clamp(3rem, 7vw, 6rem);
  }

  .artist-hero h1 {
    margin-top: 0.45rem;
    font-size: var(--text-hero);
    text-transform: uppercase;
  }

  .artist-hero .accent-line {
    max-width: 33rem;
    margin: 1rem 0 0;
    color: var(--muted);
    font-size: var(--text-lg);
  }

  .artist-story {
    width: min(100%, var(--content-width));
    margin-inline: auto;
    padding: clamp(5rem, 10vw, 9rem) var(--pad);
  }

  .artist-story__intro {
    max-width: 48rem;
    margin-inline: auto;
  }

  .draft-label {
    width: fit-content;
    margin: 0 0 1.25rem;
    padding: 0.45rem 0.65rem;
    border: 1px solid var(--rose);
    color: var(--rose);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .artist-story__intro > p:not(.draft-label) {
    margin: 1.5rem 0 0;
    color: var(--muted);
  }

  blockquote {
    margin: 2.5rem 0 0;
    padding-left: 1.5rem;
    border-left: 2px solid var(--rose);
    color: var(--text);
    font-family: var(--font-accent);
    font-size: var(--text-lg);
    font-style: italic;
  }

  .story-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: clamp(4rem, 8vw, 7rem);
    border-top: 1px solid var(--line-strong);
    border-bottom: 1px solid var(--line-strong);
  }

  .story-card {
    min-width: 0;
    padding: clamp(1.5rem, 3vw, 2.5rem);
  }

  .story-card + .story-card {
    border-left: 1px solid var(--line-strong);
  }

  .story-card__number,
  .story-card span {
    color: var(--faint);
    font-size: var(--text-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .story-card h3 {
    margin: 2rem 0 0.8rem;
    font-family: var(--font-display);
    font-size: var(--text-lg);
  }

  .story-card > p:not(.story-card__number) {
    color: var(--muted);
  }

  .story-card span {
    display: block;
    margin-top: 2rem;
    color: var(--rose);
  }

  .artist-facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--gap);
    width: min(100%, 62.5rem);
    margin-inline: auto;
    padding: 0 var(--pad) clamp(5rem, 10vw, 9rem);
    text-align: center;
  }

  .artist-facts > div {
    padding-top: 1.25rem;
    border-top: 1px solid var(--line-strong);
  }

  .artist-facts span,
  .artist-facts strong {
    display: block;
  }

  .artist-facts span {
    color: var(--faint);
    font-size: var(--text-xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .artist-facts strong {
    margin-top: 0.4rem;
    font-family: var(--font-display);
    font-size: var(--text-lg);
  }

  .signature-block {
    background: var(--surface);
  }

  .signature-block__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(14rem, 0.55fr);
    gap: clamp(2rem, 8vw, 7rem);
    align-items: center;
    width: min(100%, var(--content-width));
    margin-inline: auto;
    padding: clamp(4rem, 8vw, 7rem) var(--pad);
  }

  .signature-block h2 {
    max-width: 42rem;
    margin-top: 0.8rem;
  }

  .signature-block p:not(.eyebrow) {
    max-width: 40rem;
    color: var(--muted);
  }

  .signature-block figure {
    margin: 0;
    padding: 1.5rem;
    border: 1px solid var(--line-strong);
    background: var(--noir);
  }

  .signature-block figure img {
    width: min(100%, 18rem);
    margin-inline: auto;
    opacity: 0.86;
  }

  .signature-block figcaption {
    margin-top: 1rem;
    color: var(--faint);
    font-size: var(--text-xs);
    text-align: center;
    text-transform: uppercase;
  }

  .contact-handoff {
    border-top: 1px solid var(--line);
    text-align: center;
  }

  .contact-handoff__inner {
    width: min(100%, 55rem);
    margin-inline: auto;
    padding: clamp(5rem, 10vw, 8rem) var(--pad);
  }

  .contact-handoff h2 {
    margin-top: 0.8rem;
  }

  .contact-handoff p:not(.eyebrow) {
    color: var(--muted);
  }

  .contact-handoff__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.5rem;
    justify-content: center;
    align-items: center;
    margin-top: 2rem;
  }

  .button {
    display: inline-flex;
    min-height: 3rem;
    align-items: center;
    justify-content: center;
    padding: 0.75rem 1rem;
    background: var(--text);
    color: var(--noir);
    font-weight: 600;
  }

  .text-link {
    color: var(--muted);
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  @media (max-width: 48rem) {
    .story-grid,
    .artist-facts,
    .signature-block__inner {
      grid-template-columns: 1fr;
    }

    .story-card + .story-card {
      border-top: 1px solid var(--line-strong);
      border-left: 0;
    }

    .artist-hero {
      min-height: 70vh;
    }

    .artist-hero > img {
      object-position: 62% center;
    }
  }
</style>
