---
import { getCollection } from 'astro:content';
import ArtworkCard from '../components/ArtworkCard.astro';
import FilterBar from '../components/FilterBar.astro';
import Reveal from '../components/Reveal.astro';
import Base from '../layouts/Base.astro';
import { accentFor } from '../lib/series.js';

const artworks = (await getCollection('artworks'))
  .map((entry) => entry.data)
  .sort((a, b) => a.sortOrder - b.sortOrder || a.title.localeCompare(b.title, 'fr'));

const groups = [...artworks.reduce((map, artwork) => {
  if (!map.has(artwork.seriesSlug)) {
    map.set(artwork.seriesSlug, { slug: artwork.seriesSlug, name: artwork.series, artworks: [] });
  }
  map.get(artwork.seriesSlug).artworks.push(artwork);
  return map;
}, new Map()).values()];

const filters = groups.map(({ slug, name }) => ({ slug, name: name === 'Other' ? 'Autres œuvres' : name }));
---

<Base
  title="Œuvres"
  description="Parcourir le catalogue Carlay Art par série et par statut de disponibilité."
  currentPath="/boutique"
>
  <header class="shop-hero">
    <Reveal>
      <p class="eyebrow">La galerie</p>
      <h1 class="display">Les œuvres</h1>
      <p class="accent-line">Catalogue de travail · Acrylique sur toile</p>
    </Reveal>
  </header>

  <FilterBar series={filters} total={artworks.length} />

  <div class="catalog-note" role="note">
    <strong>Inventaire en validation.</strong>
    Les prix affichés sont issus du catalogue historique. Une œuvre n’apparaît comme disponible qu’après
    approbation explicite de son statut et de son image intégrale.
  </div>

  <div class="catalog" data-catalog>
    {groups.map((group) => (
      <section
        class="catalog-series"
        data-artwork-group
        data-series={group.slug}
        aria-labelledby={`series-${group.slug}`}
        style={`--series-accent: ${accentFor(group.slug)}`}
      >
        <Reveal class="catalog-series__head">
          <div>
            <p class="eyebrow">Série</p>
            <h2 class="display" id={`series-${group.slug}`}>
              {group.name === 'Other' ? 'Autres œuvres' : group.name}
            </h2>
          </div>
          <p>{group.artworks.length} {group.artworks.length === 1 ? 'œuvre' : 'œuvres'}</p>
        </Reveal>
        <div class="catalog-series__grid">
          {group.artworks.map((artwork) => <ArtworkCard artwork={artwork} />)}
        </div>
      </section>
    ))}

    <p class="catalog__empty">
      Aucune œuvre ne correspond à ces filtres. Les disponibilités restent fermées jusqu’à validation du
      propriétaire.
    </p>
  </div>
</Base>

<style>
  .shop-hero {
    padding: clamp(5rem, 12vw, 9rem) var(--pad) clamp(3rem, 7vw, 4.5rem);
    background:
      radial-gradient(ellipse 55% 60% at 50% 0%, rgb(139 92 246 / 10%), transparent 70%),
      var(--noir);
    text-align: center;
  }

  .shop-hero h1 {
    margin-top: 0.45rem;
    font-size: var(--text-2xl);
    text-transform: uppercase;
  }

  .shop-hero .accent-line {
    margin: 1rem 0 0;
    color: var(--muted);
    font-size: var(--text-lg);
  }

  .catalog-note {
    width: min(calc(100% - (2 * var(--pad))), var(--content-width));
    margin: clamp(2.5rem, 6vw, 4rem) auto 0;
    padding: 0.9rem 1rem;
    border: 1px dashed var(--line-strong);
    color: var(--muted);
    font-size: var(--text-sm);
  }

  .catalog-note strong {
    color: var(--text);
  }

  .catalog {
    width: min(100%, var(--content-width));
    margin-inline: auto;
    padding: 0 var(--pad) clamp(5rem, 10vw, 8rem);
  }

  .catalog-series__head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    margin: clamp(3.5rem, 8vw, 6rem) 0 1.75rem;
    padding-bottom: 1rem;
    border-bottom: 2px solid var(--series-accent);
  }

  .catalog-series__head h2 {
    margin-top: 0.35rem;
    font-size: var(--text-xl);
  }

  .catalog-series__head > p {
    margin: 0;
    color: var(--faint);
    font-size: var(--text-sm);
  }

  .catalog-series__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(2rem, 5vw, 4rem) var(--gap);
  }

  .catalog-series[hidden] {
    display: none;
  }

  .catalog__empty {
    display: none;
    max-width: 38rem;
    margin: 5rem auto 0;
    padding: 1.25rem;
    border: 1px solid var(--line-strong);
    color: var(--muted);
    text-align: center;
  }

  .catalog:not(:has(.catalog-series:not([hidden]))) .catalog__empty {
    display: block;
  }

  @media (max-width: 56.25rem) {
    .catalog-series__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 35rem) {
    .catalog-note {
      margin-top: 3.5rem;
    }

    .catalog-series__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
