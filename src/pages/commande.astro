---
import Base from '../layouts/Base.astro';
---

<Base
  title="Commande démo"
  currentPath="/commande"
  description="Parcours de commande local en mode démonstration — aucune donnée de paiement n’est demandée ni transmise."
>
  <section class="commerce-page commerce-page--checkout">
    <header class="commerce-header">
      <p class="eyebrow">Étape 2 sur 2 · Démonstration</p>
      <h1 class="display">Vos coordonnées</h1>
      <p>Testez le parcours sans transmettre de paiement. Aucun fournisseur de paiement réel n’est connecté et aucun débit ne peut avoir lieu.</p>
    </header>

    <p class="loading-state" data-checkout-loading role="status">Vérification du panier…</p>
    <noscript><p class="notice notice--error">JavaScript est nécessaire pour utiliser la commande de démonstration. Aucun paiement n’est disponible.</p></noscript>

    <div class="checkout-layout" data-checkout-content>
      <details class="order-summary" data-order-summary>
        <summary>Récapitulatif <span data-summary-count></span></summary>
        <div class="order-summary__content">
          <ul class="summary-lines" data-summary-items></ul>
          <p class="cart-total"><span>Sous-total des œuvres</span><strong data-summary-total></strong></p>
          <a class="text-link" href="/panier/">Modifier le panier</a>
        </div>
      </details>

      <form class="checkout-form" data-checkout-form novalidate>
        <div class="notice notice--error error-summary" data-error-summary role="alert" tabindex="-1" hidden>
          <h2>Vérifiez les informations indiquées</h2>
          <ul data-error-list></ul>
        </div>

        <div class="notice notice--error" data-checkout-cart-error tabindex="-1" hidden>
          <p data-checkout-cart-error-message></p>
          <button class="text-button" type="button" data-checkout-retry>Réessayer</button>
        </div>

        <fieldset data-checkout-fields disabled>
          <legend>Adresse de contact et de livraison</legend>
          <p class="field-note">Tous les champs marqués « requis » sont nécessaires à la simulation. Ils ne sont pas envoyés à un serveur.</p>
          <div class="field-grid field-grid--two">
            <div class="field">
              <label for="prenom">Prénom <span>requis</span></label>
              <input id="prenom" name="prenom" type="text" autocomplete="shipping given-name" required aria-describedby="prenom-error" />
              <p class="field-error" id="prenom-error" data-field-error="prenom"></p>
            </div>
            <div class="field">
              <label for="nom">Nom <span>requis</span></label>
              <input id="nom" name="nom" type="text" autocomplete="shipping family-name" required aria-describedby="nom-error" />
              <p class="field-error" id="nom-error" data-field-error="nom"></p>
            </div>
          </div>
          <div class="field">
            <label for="email">E-mail <span>requis</span></label>
            <input id="email" name="email" type="email" autocomplete="email" inputmode="email" required aria-describedby="email-error email-note" />
            <p class="field-note" id="email-note">Utilisé uniquement dans cette page de démonstration.</p>
            <p class="field-error" id="email-error" data-field-error="email"></p>
          </div>
          <div class="field">
            <label for="adresse">Adresse <span>requis</span></label>
            <input id="adresse" name="adresse" type="text" autocomplete="shipping address-line1" required aria-describedby="adresse-error" />
            <p class="field-error" id="adresse-error" data-field-error="adresse"></p>
          </div>
          <div class="field">
            <label for="adresse2">Complément d’adresse <span>facultatif</span></label>
            <input id="adresse2" name="adresse2" type="text" autocomplete="shipping address-line2" />
          </div>
          <div class="field-grid field-grid--two">
            <div class="field">
              <label for="cp">Code postal <span>requis</span></label>
              <input id="cp" name="cp" type="text" autocomplete="shipping postal-code" inputmode="text" required aria-describedby="cp-error" />
              <p class="field-error" id="cp-error" data-field-error="cp"></p>
            </div>
            <div class="field">
              <label for="ville">Ville <span>requis</span></label>
              <input id="ville" name="ville" type="text" autocomplete="shipping address-level2" required aria-describedby="ville-error" />
              <p class="field-error" id="ville-error" data-field-error="ville"></p>
            </div>
          </div>
          <div class="field-grid field-grid--two">
            <div class="field">
              <label for="pays">Pays <span>requis</span></label>
              <select id="pays" name="pays" autocomplete="shipping country" required aria-describedby="pays-error">
                <option value="">Choisir un pays</option>
                <option value="FR">France</option>
                <option value="BE">Belgique</option>
                <option value="CH">Suisse</option>
                <option value="GB">Royaume-Uni</option>
                <option value="US">États-Unis</option>
                <option value="CA">Canada</option>
                <option value="OTHER">Autre pays</option>
              </select>
              <p class="field-error" id="pays-error" data-field-error="pays"></p>
            </div>
            <div class="field">
              <label for="region">Région / État / Province <span data-region-requirement>facultatif</span></label>
              <input id="region" name="region" type="text" autocomplete="shipping address-level1" aria-describedby="region-error region-note" />
              <p class="field-note" id="region-note">Requis pour les États-Unis et le Canada.</p>
              <p class="field-error" id="region-error" data-field-error="region"></p>
            </div>
          </div>
        </fieldset>

        <fieldset class="payment-choice" data-checkout-fields disabled>
          <legend>Préférence de paiement — simulation uniquement</legend>
          <label class="radio-card">
            <input type="radio" name="method" value="card-demo" checked />
            <span><strong>Carte — démo</strong><small>Aucune donnée de carte n’est demandée ni transmise.</small></span>
          </label>
          <label class="radio-card">
            <input type="radio" name="method" value="bank-demo" />
            <span><strong>Virement — démo</strong><small>Simple préférence affichée, sans instruction bancaire.</small></span>
          </label>
          <label class="radio-card">
            <input type="radio" name="method" value="crypto-demo" />
            <span><strong>Actif numérique — démo</strong><small>Aucune adresse, portefeuille ou transaction n’est créé.</small></span>
          </label>
        </fieldset>

        <div class="demo-panel">
          <h2>Mode démonstration</h2>
          <p>La validation crée uniquement un récapitulatif local dans cet onglet. Aucun paiement, réservation d’inventaire, e-mail ou commande réelle n’est créé.</p>
          <label class="check-field">
            <input id="demo_ack" type="checkbox" name="demo_ack" value="yes" data-demo-ack />
            <span>Je comprends qu’il s’agit d’une démonstration sans paiement.</span>
          </label>
          <p class="field-error" id="demo_ack-error" data-field-error="demo_ack"></p>
          <details class="failure-control">
            <summary>Tester la récupération après erreur</summary>
            <label class="check-field">
              <input type="checkbox" name="simulate_failure" value="yes" />
              <span>Simuler un échec au prochain essai.</span>
            </label>
          </details>
        </div>

        <p class="checkout-status" data-checkout-status role="status" aria-live="polite"></p>
        <button class="button button--primary checkout-submit" type="submit" data-checkout-submit disabled>
          <span data-submit-label>Simuler la commande</span>
        </button>
        <p class="policy-review">Les politiques de livraison, taxes, droits, retours et dommages ne sont pas encore approuvées et ne sont pas présentées comme des conditions commerciales.</p>
      </form>

    </div>
  </section>

  <script>
    import { createCheckout, saveDemoConfirmation, validateCustomer } from '../lib/checkout.js';

    const form = document.querySelector('[data-checkout-form]');
    const content = document.querySelector('[data-checkout-content]');
    const loading = document.querySelector('[data-checkout-loading]');
    const submit = document.querySelector('[data-checkout-submit]');
    const status = document.querySelector('[data-checkout-status]');
    const summary = document.querySelector('[data-order-summary]');
    let submitting = false;
    const money = (amount, currency = 'EUR') => new Intl.NumberFormat('fr-FR', {
      style: 'currency', currency, maximumFractionDigits: 0,
    }).format(amount);

    const setFieldError = (name, message = '') => {
      const input = form?.elements.namedItem(name);
      const error = form?.querySelector(`[data-field-error="${name}"]`);
      if (input instanceof HTMLElement) input.setAttribute('aria-invalid', message ? 'true' : 'false');
      if (error) error.textContent = message;
    };

    const clearErrors = () => {
      form?.querySelectorAll('[data-field-error]').forEach((node) => (node.textContent = ''));
      form?.querySelectorAll('[aria-invalid]').forEach((node) => node.setAttribute('aria-invalid', 'false'));
      const errorSummary = form?.querySelector('[data-error-summary]');
      if (errorSummary instanceof HTMLElement) errorSummary.hidden = true;
    };

    const showErrors = (errors) => {
      clearErrors();
      const errorSummary = form?.querySelector('[data-error-summary]');
      const list = form?.querySelector('[data-error-list]');
      const items = [];
      for (const [name, message] of Object.entries(errors)) {
        setFieldError(name, message);
        const li = document.createElement('li');
        const link = document.createElement('a');
        link.href = `#${name}`;
        link.textContent = message;
        li.append(link);
        items.push(li);
      }
      list?.replaceChildren(...items);
      if (errorSummary instanceof HTMLElement) {
        errorSummary.hidden = false;
        errorSummary.focus();
      }
    };

    const render = () => {
      if (!window.CarlayCart || !(content instanceof HTMLElement) || !(form instanceof HTMLFormElement)) return;
      const snapshot = window.CarlayCart.getCartSnapshot();
      content.hidden = false;
      if (loading instanceof HTMLElement) loading.hidden = true;
      const items = snapshot.items.map((item) => {
        const li = document.createElement('li');
        const link = document.createElement('a');
        link.href = `/oeuvre/${item.slug}/`;
        link.textContent = item.title;
        const price = document.createElement('strong');
        price.textContent = money(item.price.amount, item.price.currency);
        li.append(link, price);
        return li;
      });
      content.querySelector('[data-summary-items]')?.replaceChildren(...items);
      const count = content.querySelector('[data-summary-count]');
      if (count) count.textContent = `· ${snapshot.count} œuvre${snapshot.count === 1 ? '' : 's'}`;
      const total = content.querySelector('[data-summary-total]');
      if (total) total.textContent = snapshot.total === null ? 'Indisponible' : money(snapshot.total, snapshot.currency);
      const error = form.querySelector('[data-checkout-cart-error]');
      const errorMessage = form.querySelector('[data-checkout-cart-error-message]');
      const message = snapshot.status.kind === 'error'
        ? snapshot.status.message
        : snapshot.items.length === 0
          ? 'Votre panier est vide ou ne contient plus d’œuvre disponible. Revenez aux œuvres pour poursuivre.'
          : '';
      if (error instanceof HTMLElement) error.hidden = !message;
      if (errorMessage) errorMessage.textContent = message;
      form.querySelectorAll('[data-checkout-fields]').forEach((fieldset) => {
        if (fieldset instanceof HTMLFieldSetElement) fieldset.disabled = Boolean(message) || submitting;
      });
      if (submit instanceof HTMLButtonElement) submit.disabled = Boolean(message) || submitting;
      if (summary instanceof HTMLDetailsElement && window.matchMedia('(min-width: 56.251rem)').matches) summary.open = true;
    };

    window.addEventListener('cart:ready', render);
    window.addEventListener('cart:change', render);
    if (window.CarlayCart) render();

    form?.addEventListener('change', (event) => {
      const target = event.target;
      if (target instanceof HTMLSelectElement && target.name === 'pays') {
        const required = ['US', 'CA'].includes(target.value);
        const region = form.elements.namedItem('region');
        if (region instanceof HTMLInputElement) region.required = required;
        const label = form.querySelector('[data-region-requirement]');
        if (label) label.textContent = required ? 'requis' : 'facultatif';
      }
      if (target instanceof HTMLInputElement || target instanceof HTMLSelectElement) setFieldError(target.name);
    });

    form?.querySelector('[data-error-summary]')?.addEventListener('click', (event) => {
      const link = event.target instanceof Element ? event.target.closest('a[href^="#"]') : null;
      if (!(link instanceof HTMLAnchorElement)) return;
      const target = document.querySelector(link.hash);
      if (!(target instanceof HTMLElement)) return;
      event.preventDefault();
      target.focus();
    });

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!(form instanceof HTMLFormElement) || submitting || !window.CarlayCart) return;
      const data = new FormData(form);
      const customer = Object.fromEntries(['prenom', 'nom', 'email', 'adresse', 'adresse2', 'ville', 'cp', 'pays', 'region'].map((key) => [key, data.get(key) || '']));
      const validation = validateCustomer(customer);
      const errors = { ...validation.errors };
      if (data.get('demo_ack') !== 'yes') errors.demo_ack = 'Confirmez que vous comprenez le mode démonstration.';
      if (Object.keys(errors).length) {
        showErrors(errors);
        return;
      }
      clearErrors();
      const snapshot = window.CarlayCart.getCartSnapshot();
      if (!snapshot.items.length || snapshot.status.kind === 'error') {
        render();
        form.querySelector('[data-checkout-cart-error]')?.focus();
        return;
      }
      submitting = true;
      render();
      form.setAttribute('aria-busy', 'true');
      if (status) status.textContent = 'Création du résultat de démonstration… Aucun paiement n’est traité.';
      const label = form.querySelector('[data-submit-label]');
      if (label) label.textContent = 'Simulation en cours…';
      try {
        const result = await createCheckout({
          items: window.CarlayCart.getCartSnapshot().items,
          total: window.CarlayCart.getCartSnapshot().total,
          currency: window.CarlayCart.getCartSnapshot().currency,
          customer: validation.values,
          method: data.get('method'),
        }, {
          // Omitted on purpose: createCheckout picks demo or network from
          // CHECKOUT_TRANSPORT, so one build flag flips the whole flow.
          simulateFailure: data.get('simulate_failure') === 'yes',
          idempotencyKey: `demo:${snapshot.items.map((item) => item.id).sort().join(',')}`,
        });
        if (result.external) {
          // The buyer leaves for the provider. The cart is deliberately NOT
          // cleared here: only the webhook knows whether they actually paid,
          // and emptying it now would lose the order if they abandon.
          if (status) status.textContent = 'Redirection vers le paiement sécurisé…';
          window.location.assign(result.redirect);
          return;
        }
        saveDemoConfirmation(result.confirmation);
        const cleared = window.CarlayCart.clearCart();
        if (!cleared.ok) throw new Error('Le résultat démo a été créé, mais le panier n’a pas pu être réinitialisé. Aucun paiement n’a été pris.');
        if (status) status.textContent = 'Démonstration terminée. Aucun paiement n’a été pris.';
        window.location.assign(result.redirect);
      } catch (error) {
        submitting = false;
        render();
        form.removeAttribute('aria-busy');
        if (label) label.textContent = 'Réessayer la simulation';
        const errorSummary = form.querySelector('[data-error-summary]');
        const list = form.querySelector('[data-error-list]');
        const li = document.createElement('li');
        li.textContent = error instanceof Error ? error.message : 'La démonstration a échoué. Aucun paiement n’a été pris.';
        list?.replaceChildren(li);
        if (errorSummary instanceof HTMLElement) {
          errorSummary.hidden = false;
          errorSummary.focus();
        }
        if (status) status.textContent = 'Échec de la démonstration. Corrigez si nécessaire puis réessayez. Aucun paiement n’a été pris.';
      }
    });

    form?.querySelector('[data-checkout-retry]')?.addEventListener('click', () => {
      window.CarlayCart?.retryCartStorage();
      render();
    });
  </script>
</Base>
