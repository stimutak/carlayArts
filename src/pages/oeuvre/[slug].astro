---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { getCollection } from 'astro:content';
import ArtworkCard from '../../components/ArtworkCard.astro';
import Lightbox from '../../components/Lightbox.astro';
import Reveal from '../../components/Reveal.astro';
import CartActions from '../../components/CartActions.astro';
import Base from '../../layouts/Base.astro';
import {
  availabilityLabel,
  dimensionsLabel,
  isCommerceEligible,
  reviewedFactLabel,
  validateArtworkInventory,
} from '../../lib/artworks.js';
import { accentFor, formatPrice, textAccentFor } from '../../lib/series.js';
import { isAccessibilityFixture, withAccessibilityFixture } from '../../lib/accessibility-fixture.js';

export async function getStaticPaths() {
  const entries = await getCollection('artworks');
  const artworks = withAccessibilityFixture(entries.map((entry) => entry.data));
  validateArtworkInventory(artworks, {
    assetExists: (imagePath) => existsSync(join(process.cwd(), 'public', imagePath.replace(/^\/+/, ''))),
  });
  return artworks.map((artwork) => ({ params: { slug: artwork.slug }, props: { artwork } }));
}

const { artwork } = Astro.props;
const all = withAccessibilityFixture((await getCollection('artworks')).map((entry) => entry.data)).sort((a, b) => a.sortOrder - b.sortOrder);
const related = all.filter((candidate) => candidate.seriesSlug === artwork.seriesSlug && candidate.slug !== artwork.slug).slice(0, 3);
const accent = accentFor(artwork.seriesSlug);
const textAccent = textAccentFor(artwork.seriesSlug);
const purchasable = isCommerceEligible(artwork);
const state = availabilityLabel(artwork);
const verifiedFull = Boolean(artwork.images.full.src && artwork.images.full.reviewStatus === 'owner-approved');
const testFixture = isAccessibilityFixture(artwork);
const media = verifiedFull
  ? [artwork.images.full, ...artwork.images.details.filter((image) => image.src && image.reviewStatus === 'owner-approved')].map((image) => ({
      src: image.src,
      alt: image.alt,
      caption: 'Vue approuvée pour cette œuvre.',
    }))
  : [{
      src: artwork.images.card.src,
      alt: `${artwork.title} — aperçu du catalogue historique, fidélité intégrale non validée`,
      caption: 'Aperçu du catalogue historique.',
    }];
---

<Base
  title={artwork.title}
  currentPath="/boutique"
  description={`${artwork.title}, série ${artwork.series} — dossier d’œuvre en cours de validation propriétaire.`}
>
  <section class="artwork-room">
    <div>
      <Lightbox id={`lightbox-${artwork.slug}`} title={artwork.title} media={media} verifiedFull={verifiedFull} />
      {verifiedFull ? (
        <p class="review-note" style="margin-top: 0.8rem;">
          <strong>Médias vérifiés.</strong> La vue intégrale et les détails affichés sont approuvés pour ce dossier.
          {testFixture && ' Cette route synthétique est réservée aux tests et ne publie ni n’approuve une œuvre réelle.'}
        </p>
      ) : (
        <p class="review-note" style="margin-top: 0.8rem;">
          <strong>Catalogue en validation.</strong> L’image et les informations ci-dessous proviennent du catalogue historique et restent à confirmer avec l’artiste. L’agrandissement est réservé aux médias approuvés.
        </p>
      )}
    </div>

    <Reveal as="article" class="artwork-room__info">
      <p class="eyebrow" style={`color: ${textAccent};`}>Série {artwork.series} · à confirmer</p>
      <h1 class="display artwork-room__title">{artwork.title}</h1>

      <div class="artwork-story">
        <div>
          <h2>À propos de la série</h2>
          <p>Présentation de la série à venir.</p>
        </div>
        <div>
          <h2>Note sur l’œuvre</h2>
          <p>Note sur l’œuvre à venir.</p>
        </div>
      </div>

      <ul class="specs" aria-label="Caractéristiques de l’œuvre">
        <li><span class="k">Technique</span><span class="v">{reviewedFactLabel(artwork.medium.value, artwork.medium.reviewStatus)}</span></li>
        <li><span class="k">Dimensions</span><span class="v">{reviewedFactLabel(dimensionsLabel(artwork), artwork.dimensions.reviewStatus)}</span></li>
        <li><span class="k">Année</span><span class="v">{reviewedFactLabel(artwork.year.value, artwork.year.reviewStatus)}</span></li>
        <li><span class="k">État</span><span class="v">{reviewedFactLabel(artwork.condition.value, artwork.condition.reviewStatus)}</span></li>
        <li><span class="k">Encadrement</span><span class="v">{reviewedFactLabel(artwork.framingStatus.value, artwork.framingStatus.reviewStatus)}</span></li>
        <li><span class="k">Certificat</span><span class="v">{reviewedFactLabel(artwork.certificateStatus.value, artwork.certificateStatus.reviewStatus)}</span></li>
        <li><span class="k">Signature</span><span class="v">{reviewedFactLabel(artwork.signaturePlacement.value, artwork.signaturePlacement.reviewStatus)}</span></li>
      </ul>

      <p class="artwork-price">
        <span>{formatPrice(artwork.price.amount)}</span>
        <small>Prix du catalogue historique · à confirmer</small>
      </p>

      <div class="artwork-state" role="status">
        <strong>{state}</strong>
        {artwork.availability === 'sold' ? (
          <p>État « vendu » conservé depuis la source historique. Aucune action d’achat n’est proposée.</p>
        ) : purchasable ? (
          <p>Cette œuvre remplit les contrôles du catalogue pour le parcours de démonstration. Aucun paiement réel n’est activé.</p>
        ) : (
          <p>Cette œuvre reste hors vente jusqu’à validation de son identité, de son prix, de son état et de son image intégrale.</p>
        )}
      </div>

      <CartActions artwork={artwork} />

      <a class="btn btn--ghost" href={`/boutique/?serie=${artwork.seriesSlug}`}>Voir la série →</a>
    </Reveal>
  </section>

  {related.length > 0 && (
    <section class="related">
      <Reveal class="series-head" style={`--series: ${accent};`}>
        <h2 class="display">Plus de la série {artwork.series}</h2>
        <span class="count">{related.length} suggestions</span>
      </Reveal>
      <div class="grid-series">
        {related.map((candidate) => <ArtworkCard artwork={candidate} />)}
      </div>
    </section>
  )}
</Base>
