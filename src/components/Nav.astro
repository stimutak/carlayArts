---
import MobileMenu from './MobileMenu.astro';

const { currentPath } = Astro.props;
const links = [
  { path: '/boutique', href: '/boutique/', label: 'Œuvres' },
  { path: '/a-propos', href: '/a-propos/', label: "L’Artiste" },
  { path: '/contact', href: '/contact/', label: 'Contact' },
];
---

<header class="nav">
  <a class="nav__logo" href="/" aria-label="Carlay Art, accueil">CARLAY ART</a>
  <nav class="nav__links" aria-label="Navigation principale">
    {links.map((link) => (
      <a href={link.href} aria-current={currentPath === link.path ? 'page' : undefined}>{link.label}</a>
    ))}
  </nav>
  <div class="nav__actions">
    <a
      class="nav__cart-link"
      href="/panier/"
      aria-current={currentPath === '/panier' ? 'page' : undefined}
      aria-haspopup="dialog"
      data-cart-open
    >
      Panier <span class="nav__cart-count" data-cart-count aria-label="Statut du panier en cours de chargement">—</span>
    </a>
    <button
      id="site-menu-toggle"
      class="nav__burger"
      type="button"
      aria-controls="site-mobile-menu"
      aria-expanded="false"
    >
      <span class="sr-only">Ouvrir le menu</span>
      <span aria-hidden="true">Menu</span>
    </button>
  </div>
</header>

<MobileMenu currentPath={currentPath} />

<script>

  // The nav sits transparent over the page and blurs in once you leave the
  // top, so the hero reads full-bleed. Passive listener; no layout reads.
  const siteNav = document.querySelector('.nav');
  if (siteNav instanceof HTMLElement) {
    const syncScrolled = () => {
      siteNav.classList.toggle('nav--scrolled', window.scrollY > 12);
    };
    syncScrolled();
    window.addEventListener('scroll', syncScrolled, { passive: true });
  }
  const toggle = document.querySelector('#site-menu-toggle');
  const menu = document.querySelector('#site-mobile-menu');

  if (toggle instanceof HTMLButtonElement && menu instanceof HTMLElement) {
    const closeButton = menu.querySelector('[data-menu-close]');
    const toggleLabel = toggle.querySelector('.sr-only');
    const focusableSelector = 'a[href], button:not([disabled])';
    const backgroundElements = [
      document.querySelector('.skip-link'),
      document.querySelector('.nav'),
      document.querySelector('main'),
      document.querySelector('.footer'),
      document.querySelector('[data-cart-shell]'),
    ].filter((node) => node instanceof HTMLElement);
    let inerted = [];

    const setBackgroundInert = () => {
      inerted = backgroundElements.map((element) => ({ element, wasInert: element.inert }));
      inerted.forEach(({ element }) => { element.inert = true; });
    };

    const restoreBackground = () => {
      inerted.forEach(({ element, wasInert }) => { element.inert = wasInert; });
      inerted = [];
    };

    const closeMenu = ({ returnFocus = true } = {}) => {
      menu.hidden = true;
      toggle.setAttribute('aria-expanded', 'false');
      if (toggleLabel) toggleLabel.textContent = 'Ouvrir le menu';
      document.body.classList.remove('menu-open');
      restoreBackground();
      if (returnFocus) toggle.focus();
    };

    const openMenu = () => {
      menu.hidden = false;
      toggle.setAttribute('aria-expanded', 'true');
      if (toggleLabel) toggleLabel.textContent = 'Fermer le menu';
      document.body.classList.add('menu-open');
      setBackgroundInert();
      menu.querySelector(focusableSelector)?.focus();
    };

    toggle.addEventListener('click', () => {
      if (menu.hidden) openMenu();
      else closeMenu();
    });

    closeButton?.addEventListener('click', () => closeMenu());
    menu.addEventListener('click', (event) => {
      if (event.target === menu) closeMenu();
      if (event.target instanceof HTMLAnchorElement) closeMenu({ returnFocus: false });
    });

    document.addEventListener('keydown', (event) => {
      if (menu.hidden) return;
      if (event.key === 'Escape') {
        event.preventDefault();
        closeMenu();
        return;
      }
      if (event.key !== 'Tab') return;

      const focusable = [...menu.querySelectorAll(focusableSelector)].filter(
        (element) => element instanceof HTMLElement,
      );
      const first = focusable[0];
      const last = focusable.at(-1);
      if (!first || !last) return;

      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    });

    const desktopQuery = window.matchMedia('(min-width: 56.251rem)');
    desktopQuery.addEventListener('change', (event) => {
      if (event.matches && !menu.hidden) closeMenu({ returnFocus: false });
    });

    document.documentElement.classList.add('js-nav-ready');
  }
</script>
