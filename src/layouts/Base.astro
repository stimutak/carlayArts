---
import '@fontsource-variable/space-grotesk/wght.css';
import '@fontsource/playfair-display/400-italic.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/components.css';
import { canonicalPath, pageTitle } from '../lib/metadata.js';

interface Props {
  title: string;
  description?: string;
  currentPath?: string;
  draft?: boolean;
}

const {
  title,
  description = 'Carlay Art — artiste contemporaine française. Œuvres originales.',
  currentPath = Astro.url.pathname.replace(/\/$/, '') || '/',
  draft = true,
} = Astro.props;
const canonical = new URL(canonicalPath(Astro.url.pathname), Astro.site);
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>document.documentElement.classList.add('js')</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {draft && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/site/logo-carlay-BLANC.png" type="image/png" />
    <link rel="preconnect" href="https://api.fontshare.com" crossorigin="anonymous" />
    <link rel="preconnect" href="https://cdn.fontshare.com" crossorigin="anonymous" />
    <link
      rel="stylesheet"
      href="https://api.fontshare.com/v2/css?f[]=clash-display@600,700&display=swap"
    />
    <title>{pageTitle(title)}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Aller au contenu</a>
    <Nav currentPath={currentPath} />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <script>
      const revealElements = [...document.querySelectorAll('.reveal')];
      if (!('IntersectionObserver' in window)) {
        revealElements.forEach((element) => element.classList.add('is-in'));
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('is-in');
              observer.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -8% 0px' },
        );

        revealElements.forEach((element) => {
          const bounds = element.getBoundingClientRect();
          if (bounds.top < window.innerHeight && bounds.bottom > 0) element.classList.add('is-in');
          else observer.observe(element);
        });
      }
    </script>
  </body>
</html>
