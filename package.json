  "license": "ISC",
  "dependencies": {
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "playwright": "^1.57.0"
  },
  "devDependencies": {
    "astro": "^5.18.2",
    "jsdom": "^26.1.0",
    "vitest": "^3.2.7"
  }
}
