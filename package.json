{
  "name": "carlayarts",
  "version": "1.0.0",
  "description": "Carlay Art - French contemporary artist website",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "test": "vitest run --exclude tests/dist.test.js",
    "test:watch": "vitest --exclude tests/dist.test.js",
    "test:dist": "vitest run tests/dist.test.js",
    "test:browser": "node scripts/check-foundation-browser.mjs",
    "check": "npm run test && npm run build && npm run test:dist",
    "extract": "node scripts/extract-artworks.mjs",
    "dev:legacy": "npx serve .",
    "scrape": "node scripts/scrape-site-standalone.js",
    "scrape:install": "npx playwright install chromium && npm run scrape",
    "audit:production": "npm audit --omit=dev"
  },
  "repository": {
    "type": "git",
    "url": "http://local_proxy@127.0.0.1:28317/git/stimutak/carlayArts"
  },
  "keywords": [],
